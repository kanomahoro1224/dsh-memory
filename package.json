{
  "name": "dsh-memory",
  "version": "0.1.0",
  "description": "Observational memory plugin for DeepSeek Harness — background observer/reflector/dropper consolidation over a cache-friendly tiered compaction backend.",
  "type": "module",
  "license": "MIT",
  "author": "elpapi42 (ported for DeepSeek Harness)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanomahoro1224/dsh-memory.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "observational-memory",
    "memory",
    "compaction"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./engine": {
      "types": "./lib/compaction/engine.d.ts",
      "default": "./lib/compaction/engine.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-token-meter": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-include": "^1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-atomic-write": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-authorization": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-base": "0.1.5-rc.1",
    "@deepseek-ai/dsh-bash-local": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-code-runtime": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.5-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.1.5-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-fs": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-http-proxy": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-jobs": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-launch-environment": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-message-feedback": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-pwsh-local": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-sandbox": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-scope": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session-query": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session-telemetry": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session-title-llm": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-shell": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-spill": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-subagent-in-process-driver": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
